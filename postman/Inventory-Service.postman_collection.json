{
  "info": {
    "_postman_id": "b62dcba3-d3f6-41e7-a178-78561fa76a43",
    "name": "OMS Inventory Service",
    "description": "Requests for retrieving inventory and updating available stock.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Inventory by Product ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains only inventory fields\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.all.keys(\"productId\", \"availableQuantity\");",
              "    pm.expect(response.productId).to.eql(Number(pm.collectionVariables.get(\"productId\")));",
              "    pm.expect(response.availableQuantity).to.be.a(\"number\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/inventory/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventory",
            "{{productId}}"
          ]
        },
        "description": "Returns productId and availableQuantity for an existing inventory record."
      },
      "response": [
        {
          "name": "Success",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "{{productId}}"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"productId\": 1,\n  \"availableQuantity\": 25\n}"
        }
      ]
    },
    {
      "name": "Update Inventory Stock",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Stock was updated\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.all.keys(\"productId\", \"availableQuantity\");",
              "    pm.expect(response.productId).to.eql(Number(pm.collectionVariables.get(\"productId\")));",
              "    pm.expect(response.availableQuantity).to.eql(Number(pm.collectionVariables.get(\"stockQuantity\")));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"availableQuantity\": {{stockQuantity}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/inventory/{{productId}}/stock",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventory",
            "{{productId}}",
            "stock"
          ]
        },
        "description": "Updates only availableQuantity. The quantity must be zero or greater."
      },
      "response": [
        {
          "name": "Success",
          "originalRequest": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availableQuantity\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/inventory/{{productId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "{{productId}}",
                "stock"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"productId\": 1,\n  \"availableQuantity\": 25\n}"
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8091",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "stockQuantity",
      "value": "25",
      "type": "string"
    }
  ]
}
