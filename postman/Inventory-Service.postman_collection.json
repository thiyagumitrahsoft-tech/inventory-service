      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Product was created\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.all.keys(\"id\", \"name\", \"sku\", \"price\", \"status\");",
                  "    pm.expect(response.name).to.eql(pm.collectionVariables.get(\"productName\"));",
                  "    pm.expect(response.sku).to.eql(pm.collectionVariables.get(\"productSku\"));",
                  "    pm.collectionVariables.set(\"productId\", String(response.id));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "name",
                  "value": "{{productName}}",
                  "type": "text"
                },
                {
                  "key": "sku",
                  "value": "{{productSku}}",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "{{productPrice}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            },
            "description": "Creates a product using form fields, matching the current ProductController method signature. Change productSku before sending the request again because SKU is unique."
          },
          "response": [
            {
