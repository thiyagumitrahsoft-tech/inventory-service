    {
      "name": "Update Inventory Stock",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Stock was updated\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.all.keys(\"productId\", \"availableQuantity\");",
              "    pm.expect(response.productId).to.eql(Number(pm.collectionVariables.get(\"productId\")));",
              "    pm.expect(response.availableQuantity).to.eql(Number(pm.collectionVariables.get(\"stockQuantity\")));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
